# CLAVIS Environment Configuration

# Database (Default is SQLite, can be swapped for PostgreSQL)
DATABASE_URL=sqlite:///./clavis.db
# DATABASE_URL=postgresql://user:password@localhost:5432/clavis

# External Threat Intelligence APIs (Optional - Local heuristics will operate if unset)
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_API_KEY=

# Configurable Risk Thresholds
LOW_THRESHOLD_MAX=24
MEDIUM_THRESHOLD_MAX=49
HIGH_THRESHOLD_MAX=74
